---
import AdSlot from "../components/AdSlot.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description, jsonLd } = Astro.props;

const navLinks = [
  { href: "/1099-vs-w2-calculator/", label: "1099 vs W2" },
  { href: "/quarterly-tax-calculator/", label: "Quarterly Tax" },
  { href: "/s-corp-savings-calculator/", label: "S-Corp Savings" },
  { href: "/freelance-rate-calculator/", label: "Freelance Rate" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Freelance Tax Toolkit</title>
    {description && <meta name="description" content={description} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      // Runs before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #ffffff;
        --bg-elevated: #ffffff;
        --bg-subtle: #f5f6f8;
        --text: #16181d;
        --text-muted: #5b6472;
        --border: #e4e7ec;
        --primary: #3457d5;
        --primary-hover: #2941ac;
        --primary-contrast: #ffffff;
        --success: #15803d;
        --success-bg: #eafaf0;
        --warning: #92400e;
        --warning-bg: #fef3e2;
        --danger: #b91c1c;
        --danger-bg: #fdecec;
        --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 4px 16px rgba(16, 24, 40, 0.06);
        --radius: 14px;
        --radius-sm: 8px;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, Roboto, sans-serif;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #0e1015;
        --bg-elevated: #171a21;
        --bg-subtle: #1b1e27;
        --text: #eceef1;
        --text-muted: #9aa3af;
        --border: #2a2e38;
        --primary: #7c96ff;
        --primary-hover: #97acff;
        --primary-contrast: #0e1015;
        --success: #4ade80;
        --success-bg: #123423;
        --warning: #fbbf24;
        --warning-bg: #3a2c0f;
        --danger: #f87171;
        --danger-bg: #3a1616;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.5);
      }

      * { box-sizing: border-box; }

      body {
        font-family: var(--font-sans);
        margin: 0;
        line-height: 1.55;
        color: var(--text);
        background: var(--bg);
        padding-bottom: 88px; /* room for the fixed consent banner */
        transition: background 0.15s ease, color 0.15s ease;
      }

      main, .page-width {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 20px;
      }

      a { color: var(--primary); }
      a:hover { color: var(--primary-hover); }

      h1 { font-size: 1.85rem; letter-spacing: -0.02em; margin: 8px 0 4px; }
      h2 { font-size: 1.2rem; margin-top: 40px; }
      p.lede { color: var(--text-muted); font-size: 1.05rem; margin-top: 0; }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 20px;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }
      .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px 16px;
        max-width: 760px;
        margin: 0 auto;
        width: 100%;
      }
      @media (max-width: 640px) {
        .site-nav {
          order: 3;
          flex-basis: 100%;
          justify-content: center;
          overflow-x: auto;
          flex-wrap: nowrap;
        }
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand:hover { color: var(--text); }
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
      }
      .site-nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 6px 10px;
        border-radius: var(--radius-sm);
        white-space: nowrap;
      }
      .site-nav a:hover { background: var(--bg-subtle); color: var(--text); }

      .theme-toggle {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        color: var(--text);
        cursor: pointer;
        flex-shrink: 0;
      }
      .theme-toggle:hover { background: var(--bg-subtle); }
      .theme-toggle svg { width: 18px; height: 18px; }
      :root[data-theme="dark"] .theme-toggle .icon-sun { display: none; }
      :root:not([data-theme="dark"]) .theme-toggle .icon-moon { display: none; }

      /* Cards / forms */
      .card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px;
        margin: 24px 0;
      }
      form { display: grid; gap: 16px; margin: 0; }
      label { display: grid; gap: 6px; font-size: 0.88rem; font-weight: 500; color: var(--text-muted); }
      input, select {
        padding: 10px 12px;
        font-size: 1rem;
        font-family: inherit;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      input:focus, select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);
      }
      label:has(input[type="checkbox"]) {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
      }
      button[type="submit"] {
        padding: 12px 20px;
        font-size: 1rem;
        font-weight: 600;
        background: var(--primary);
        color: var(--primary-contrast);
        border: none;
        border-radius: var(--radius-sm);
        cursor: pointer;
        width: fit-content;
        transition: background 0.15s ease, transform 0.05s ease;
      }
      button[type="submit"]:hover { background: var(--primary-hover); }
      button[type="submit"]:active { transform: scale(0.98); }

      /* Results */
      #results {
        margin-top: 24px;
        padding: 20px;
        background: var(--bg-subtle);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        display: none;
      }
      #results.visible { display: block; }
      .result-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
        font-size: 0.95rem;
      }
      .result-row:last-child { border-bottom: none; }
      .result-row strong { font-variant-numeric: tabular-nums; }
      .result-row.headline {
        font-size: 1.15rem;
        padding-bottom: 14px;
        margin-bottom: 4px;
        border-bottom: 1px solid var(--border);
      }

      .msg {
        padding: 10px 14px;
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        margin: 0 0 12px;
      }
      .msg-warning { background: var(--warning-bg); color: var(--warning); }
      .msg-success { background: var(--success-bg); color: var(--success); }
      .msg-danger { background: var(--danger-bg); color: var(--danger); }

      /* Home page tool grid */
      .tool-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin: 24px 0;
      }
      .tool-card {
        display: block;
        padding: 20px;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-decoration: none;
        color: var(--text);
        box-shadow: var(--shadow);
        transition: transform 0.12s ease, border-color 0.12s ease;
      }
      .tool-card:hover { transform: translateY(-2px); border-color: var(--primary); color: var(--text); }
      .tool-card__icon { font-size: 1.5rem; }
      .tool-card h3 { margin: 10px 0 4px; font-size: 1.05rem; }
      .tool-card p { margin: 0; font-size: 0.88rem; color: var(--text-muted); }

      /* Footer */
      footer { margin-top: 56px; font-size: 0.85rem; color: var(--text-muted); }
      footer .footer-links { display: flex; flex-wrap: wrap; gap: 4px 12px; }
      footer .footer-links a { color: var(--text-muted); text-decoration: none; }
      footer .footer-links a:hover { color: var(--text); }
      .disclaimer {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 16px;
        border-top: 1px solid var(--border);
        padding-top: 12px;
      }

      ul { padding-left: 1.2em; }
      li { margin-bottom: 6px; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">🧮 Freelance Tax Toolkit</a>
        <nav class="site-nav">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>
      </div>
    </header>
    <main class="page-width">
      <slot />
      <AdSlot position="bottom" />
      <footer>
        <div class="footer-links">
          <a href="/about/">About</a>
          <a href="/methodology/">Methodology</a>
          <a href="/disclaimers/">Disclaimers</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/contact/">Contact</a>
        </div>
        <p class="disclaimer">
          Not tax, legal, or financial advice. These calculators use IRS Rev. Proc. 2025-32 federal figures
          for tax year 2026; state tax coverage is currently partial. Consult a licensed CPA or attorney
          for your specific situation.
        </p>
      </footer>
    </main>
    <ConsentBanner />

    <script>
      const toggle = document.getElementById("theme-toggle") as HTMLButtonElement;
      toggle.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme");
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
