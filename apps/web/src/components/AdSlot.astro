---
interface Props {
  position: "top-banner" | "mid-content" | "bottom" | "sidebar";
  slot?: string;
}
const { position, slot } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const isLive = Boolean(client && slot);

const heights: Record<Props["position"], string> = {
  "top-banner": "100px",
  "mid-content": "250px",
  bottom: "250px",
  sidebar: "600px",
};
---
<div
  class={`ad-slot ad-slot--${position}`}
  style={`min-height: ${heights[position]};`}
  data-ad-position={position}
  aria-label="Advertisement"
>
  <span class="ad-slot__label">Advertisement</span>
  {isLive && (
    <ins
      class="adsbygoogle"
      style="display:block;width:100%;height:100%"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={position === "sidebar" ? "vertical" : "auto"}
      data-full-width-responsive={position === "sidebar" ? "false" : "true"}
    />
  )}
</div>

<style>
  .ad-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    margin: 24px 0;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ad-slot--sidebar {
    display: none;
  }
  @media (min-width: 1024px) {
    .ad-slot--sidebar {
      display: flex;
      position: sticky;
      top: 24px;
    }
  }
</style>
